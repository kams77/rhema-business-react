# Secrets du projet Synology (docker-compose.yml).
# 1. Copiez ce fichier à côté de docker-compose.yml sous le nom « .env ».
# 2. Remplacez les trois valeurs ci-dessous (20 caractères ou plus, lettres et chiffres,
#    sans espace, ni « $ », ni guillemets).
# 3. Ne partagez jamais ce fichier : il donne accès à toute la base de données.

# Mot de passe de l'application pour accéder à la base MariaDB
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_base

# Mot de passe administrateur (root) de MariaDB — à garder en lieu sûr
DB_ROOT_PASSWORD=CHANGEZ_MOI_mot_de_passe_root

# Code demandé une seule fois, à l'écran « Installation du serveur » (12 caractères ou plus)
SETUP_CODE=CHANGEZ_MOI_code_installation
