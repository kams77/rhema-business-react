# Copiez ce fichier en « .env » puis adaptez les valeurs.

# Mode démonstration (true par défaut).
#   true  : connexion en 1 clic, sélecteur d'utilisateur, mot de passe de test affiché.
#   false : mode production — identifiant + mot de passe obligatoires,
#           changement de mot de passe imposé à la première connexion.
VITE_DEMO_MODE=true

# GEMINI_API_KEY : clé de l'API Gemini (Google AI Studio).
# Pas encore utilisée par l'interface ; AI Studio l'injecte automatiquement à l'exécution.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL : adresse publique de l'application (injectée par AI Studio / Cloud Run).
APP_URL="MY_APP_URL"
