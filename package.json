{
  "name": "rhema-business",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "node server/index.mjs",
    "server:memoire": "node server/index.mjs --memoire",
    "test:api": "node server/tests/api.test.mjs",
    "test:paie": "esbuild src/lib/__tests__/payroll.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/payroll.test.mjs --log-level=error && node node_modules/.cache/payroll.test.mjs",
    "test:droits": "node server/tests/permissions.test.mjs",
    "test:integrite": "esbuild src/lib/__tests__/integrity.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/integrity.test.mjs --log-level=error && node node_modules/.cache/integrity.test.mjs && node server/tests/audit-chain.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
